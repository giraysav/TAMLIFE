# TAMLIFE Dev - ortam ayarlari ornegi. Kopyalayin: backend\.env (git disi). Var olan ortam degiskeni .env'i ezer.
# Deger yazilmamis satir varsayilani kullanir. Sir (parola/anahtar) bu ornege YAZILMAZ.

# --- AD / LDAPS (eski panelle ayni anahtarlar; E:\TAMLIFE\.env icindeki AD_* satirlari aynen tasinabilir) ---
# Bind kullanicinin kendi hesabiyla yapilir: servis hesabi / AD parolasi gerekmez.
AD_ENABLED=false
# ldaps://<dc-adi>:636  (duz ldap:// kabul edilmez)
AD_SERVER=
# UPN alani: kisa ad -> kisa@AD_DOMAIN
AD_DOMAIN=
AD_USE_SSL=true
# Kurum ara + kok CA zinciri (.pem); bos = Windows kok deposu. Ornek: D:\TAMLIFE_Dev\TAMLIFE_v3.5\kurulum\sertifika\kurumsal_ca.pem
AD_CA_CERT_FILE=
# Virgullu ek alanlar (AD_DOMAIN her zaman dahil)
AD_IZINLI_ALANLAR=
# izle | zorunlu  (alan disi giris: izle = kaydet + reddet, zorunlu = bind bile denenmez)
AD_ALAN_KONTROLU=zorunlu
# izle | zorunlu  (Who-Am-I hesabi yazilan kisa adla eslesmeli mi)
AD_KIMLIK_KONTROLU=izle
# Grup DN listesi NOKTALI VIRGULLE ayrilir (DN virgul icerir); doluysa AD_ARAMA_KOKU zorunlu
AD_IZINLI_GRUPLAR=
AD_ARAMA_KOKU=
# AD'de dogrulanan ama panelde kaydi olmayan kisi TeamMember olarak acilsin mi
AD_OTOMATIK_AC=true
