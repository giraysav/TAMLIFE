[importlinter]
root_package = app

[importlinter:contract:no-cross-service]
name = Moduller birbirinden bagimsiz
type = independence
modules =
    app.modules.baglantili
    app.modules.ekip
    app.modules.gelir_uretim
    app.modules.musteri
    app.modules.onedesk
    app.modules.proje
    app.modules.radar
    app.modules.rapor
    app.modules.roller
    app.modules.sunum
    app.modules.takvim
    app.modules.talep
    app.modules.tamapn
    app.modules.tamsms
    app.modules.topoloji
    app.modules.toptan
    app.modules.utilizasyon

[importlinter:contract:core-independent]
name = Core data adapters do not import modules
type = forbidden
source_modules =
    app.core
    app.data
    app.adapters
forbidden_modules =
    app.modules
