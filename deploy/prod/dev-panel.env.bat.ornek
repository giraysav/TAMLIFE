rem Kopyalayin: dev-panel.env.bat (git'e girmez). Gercek sirri bu ornege YAZMAYIN.
rem Sir uretmek: python -c "import secrets; print(secrets.token_urlsafe(48))"
rem Ayni deger uretim panelinin .env dosyasinda DEV_PANEL_SECRET olarak da bulunmali.

rem Yeni panelin Python'u (Python 3.12 + backend\requirements: fastapi, uvicorn, sqlalchemy, alembic ...)
set PYTHON_EXE=D:\TAMLIFE_V35\.venv\Scripts\python.exe

rem Uretim panelindeki DEV_PANEL_PORT ile ayni olmali (127.0.0.1 uzerinde dinler)
set DEV_PANEL_PORT=8117

set TAMLIFE_ENV=production
set TAMLIFE_BASE_PATH=/admin/dev
set TAMLIFE_SSO_SECRET=BURAYA-EN-AZ-32-KARAKTER-RASTGELE-SIR
set TAMLIFE_TRUSTED_PROXIES=127.0.0.1
set TAMLIFE_ALLOWED_HOSTS=tamlife,tamlife.turkcell.entp.tgc,172.28.100.7,localhost,127.0.0.1

rem PostgreSQL kurulana kadar on yayin asamasinda SQLite (yalniz bu panelin kendi dosyasi)
set TAMLIFE_SQLITE_IZIN=true
set TAMLIFE_DATABASE_URL=sqlite:///D:/TAMLIFE_V35/backend/var/panel.db

rem Derlenmis arayuz: ekran-react\dist  (npm run build:prod ile uretilir)
set TAMLIFE_STATIC_DIR=D:\TAMLIFE_V35\ekran-react\dist

rem Aylik rapor PDF arsivi
set TAMLIFE_REPORT_DIR=D:\TAMLIFE_V35\data\reports
